<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_compliance_controller</name>
  <version>0.1.0</version>
  <description>Variable impedance controller with gravity/friction compensation for OpenArm</description>
  <maintainer email="dev@enactic.com">OpenArm Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>kdl_parser</depend>
  <depend>orocos_kdl_vendor</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>controller_manager_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_torque_observer</name>
  <version>0.1.0</version>
  <description>Shadow-mode torque observer for validating gravity and friction feedforward models before enabling variable impedance control.</description>
  <maintainer email="dev@openarm.dev">OpenArm Dev</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
